{
    "version": "v1.63.0",
    "previous": "v1.62.0",
    "changes": [
        {
            "kind": "resource",
            "resource": "genesyscloud_conversations_messaging_integrations_whatsapp",
            "attribute": null,
            "change": "added",
            "summary": "New resource for managing WhatsApp messaging integrations."
        },
        {
            "kind": "resource",
            "resource": "genesyscloud_task_management_worktype_status_transition",
            "attribute": null,
            "change": "added",
            "summary": "New resource for managing worktype status transition rules."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_knowledge_document",
            "attribute": "published",
            "change": "updated",
            "summary": "Now optional, computed, and deprecated; documents are created as drafts, no longer auto-published on create, and the value is no longer synced from the API on read."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_oauth_client",
            "attribute": "client_id",
            "change": "added",
            "summary": "Computed placeholder that can be referenced from genesyscloud_integration_credential fields."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_oauth_client",
            "attribute": "client_secret",
            "change": "added",
            "summary": "Optional computed sensitive placeholder for integration credential references; the value is not stored in Terraform state."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_oauth_client",
            "attribute": "directory_client_secret",
            "change": "added",
            "summary": "Optional directory path where the client secret is written to a file on create."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_outbound_campaign",
            "attribute": "dynamic_contact_queueing_settings.filter",
            "change": "added",
            "summary": "Optional flag for dynamic contact filtering; changing the value forces resource replacement."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_outbound_campaign",
            "attribute": "dynamic_contact_queueing_settings.sort",
            "change": "updated",
            "summary": "Now optional and computed; changing the value forces resource replacement with a new campaign ID."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_outbound_campaign",
            "attribute": "dynamic_contact_queueing_settings",
            "change": "updated",
            "summary": "When omitted, default dynamic contact queue settings are applied."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_recording_media_retention_policy",
            "attribute": "conditions.team_ids",
            "change": "added",
            "summary": "Optional set of team IDs to match conversations against."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_recording_media_retention_policy",
            "attribute": "media_policies.call_policy.conditions.team_ids",
            "change": "added",
            "summary": "Optional team filter for call media policy conditions."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_recording_media_retention_policy",
            "attribute": "media_policies.chat_policy.conditions.team_ids",
            "change": "added",
            "summary": "Optional team filter for chat media policy conditions."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_recording_media_retention_policy",
            "attribute": "media_policies.email_policy.conditions.team_ids",
            "change": "added",
            "summary": "Optional team filter for email media policy conditions."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_recording_media_retention_policy",
            "attribute": "media_policies.message_policy.conditions.team_ids",
            "change": "added",
            "summary": "Optional team filter for message media policy conditions."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_routing_queue",
            "attribute": "last_agent_routing_mode",
            "change": "added",
            "summary": "Optional last-agent routing mode (Disabled, QueueMembersOnly, or AnyAgent)."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_routing_queue",
            "attribute": "users",
            "change": "updated",
            "summary": "No longer computed; omit this attribute to manage queue members outside Terraform without plan diffs."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype",
            "attribute": "disable_default_status_creation",
