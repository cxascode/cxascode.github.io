        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "category",
            "change": "updated",
            "summary": "Unknown is no longer an accepted value."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "destination_status_ids",
            "change": "updated",
            "summary": "Deprecated and computed; manage transitions with genesyscloud_task_management_worktype_status_transition instead."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "default_destination_status_id",
            "change": "updated",
            "summary": "Deprecated and computed; use genesyscloud_task_management_worktype_status_transition instead."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "status_transition_delay_seconds",
            "change": "updated",
            "summary": "Deprecated and computed; use genesyscloud_task_management_worktype_status_transition instead."
        },
        {
            "kind": "resource_attribute",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "status_transition_time",
            "change": "updated",
            "summary": "Deprecated and computed; use genesyscloud_task_management_worktype_status_transition instead."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_knowledge_document",
            "attribute": "published",
            "change": "updated",
            "summary": "Refresh no longer syncs published from the API; documents are read in draft state when published is false."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_routing_queue",
            "attribute": "users",
            "change": "updated",
            "summary": "Omitting users avoids API-populated member lists in state and reduces plan diffs when members are managed outside Terraform."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_routing_queue",
            "attribute": "last_agent_routing_mode",
            "change": "added",
            "summary": "New optional attribute accepts Disabled, QueueMembersOnly, or AnyAgent."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_outbound_campaign",
            "attribute": "dynamic_contact_queueing_settings",
            "change": "updated",
            "summary": "sort is optional and computed; filter is new; changing sort or filter forces replacement with a new campaign ID."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_oauth_client",
            "attribute": "client_id",
            "change": "added",
            "summary": "Computed placeholders appear in state for referencing from integration credentials."
        },
        {
            "kind": "plan_behavior",
            "resource": "genesyscloud_task_management_worktype_status",
            "attribute": "category",
            "change": "updated",
            "summary": "Unknown is no longer accepted; transition-related attributes are deprecated and computed."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_architect_ivr",
            "attribute": null,
            "change": "updated",
            "summary": "Create and update retry transient HTTP 400 responses before failing."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_knowledge_document",
            "attribute": "published",
            "change": "updated",
            "summary": "Create no longer publishes documents; update sets published to false after apply."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_integration_credential",
            "attribute": null,
            "change": "updated",
            "summary": "For pureCloudOAuthClient credentials without clientSecret in fields, the provider attempts to populate the secret from a matching OAuth client or provider metadata cache."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_oauth_client",
            "attribute": "directory_client_secret",
            "change": "added",
            "summary": "When set, the client secret is written to a file on create; linked integration credential create/update writes client_id to state and clears client_secret from state."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_routing_queue",
            "attribute": "last_agent_routing_mode",
            "change": "added",
            "summary": "last_agent_routing_mode is sent on create and update."
        },
        {
            "kind": "apply_behavior",
            "resource": "genesyscloud_routing_queue",
            "attribute": "users",
            "change": "updated",
            "summary": "Member ring number updates retry transient HTTP 404 responses before failing."
        },
        {
